# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Fernet key used to encrypt Binance API credentials in the local DB.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VERRE_ENCRYPTION_KEY=

# Path to the SQLite database file (default: verre.db in the cwd)
VERRE_DB_PATH=verre.db

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone (NOT recommended for live deployments).
VERRE_ALLOWED_TELEGRAM_IDS=

# Poll interval for the leaderboard (seconds). Defaults to 20.
VERRE_POLL_INTERVAL_SECONDS=20

# Optional: override Binance API endpoints (use Testnet for safe testing)
# Spot testnet:    https://testnet.binance.vision/api
# Futures testnet: https://testnet.binancefuture.com
VERRE_BINANCE_TESTNET=false

# Optional: HTTP timeout (seconds) for the leaderboard client
VERRE_LEADERBOARD_TIMEOUT=10
